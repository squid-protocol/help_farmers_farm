[flake8]
# Increase max line length (standard PEP8 is 79, which is too short for modern web dev)
max-line-length = 119

# Stop fighting Black over slices (E203), math operators (W503), and long strings (E501)
extend-ignore = E203, W503, E501

# Ignore auto-generated files and virtual environments
exclude = 
    .git,
    __pycache__,
    migrations,
    venv,
    env,
    manage.py,
    helpfarmers/settings.py